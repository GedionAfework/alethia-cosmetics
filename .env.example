# PostgreSQL. Local docker-compose publishes this on port 5433
# so it does not clash with Alethia Honey on 5432.
# On Neon/Vercel, prefer the non-pooled (direct) connection string for migrations.
DATABASE_URL="postgresql://postgres:password@localhost:5433/alethia_cosmetics"

# Telegram bot from BotFather. Leave blank for website-only local use.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Public URL of this app. Telegram Mini App buttons use it (safe to expose).
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Telegram usernames that should be treated as admin (comma-separated).
ADMIN_TELEGRAM_USERNAMES="AletheiaCo"
ADMIN_TELEGRAM_IDS=""

# Session signing secret. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-secret"

# Seeded website logins. Change these before real use.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_ADMIN_NAME="Aletheia Admin"
SEED_EMPLOYEE_USERNAME="cashier"
SEED_EMPLOYEE_PASSWORD="change-me-staff"
SEED_EMPLOYEE_NAME="Cashier"
SEED_EMPLOYEE_TELEGRAM=""
