generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  COSMETICS
  PERFUMES
  GIFTS
}

enum MovementType {
  RECEIVED
  SALE
  ADJUSTMENT
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id")
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model User {
  id               String   @id @default(cuid())
  name             String
  username         String   @unique
  passwordHash     String?  @map("password_hash")
  roleId           String   @map("role_id")
  telegramId       BigInt?  @unique @map("telegram_id")
  telegramUsername String?  @unique @map("telegram_username")
  isSuperAdmin     Boolean  @default(false) @map("is_super_admin")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  role      Role             @relation(fields: [roleId], references: [id])
  sales     Sale[]
  movements StockMovement[]

  @@index([roleId])
  @@map("users")
}

model Product {
  id                  String          @id @default(cuid())
  name                String
  sku                 String          @unique
  barcode             String?         @unique
  category            ProductCategory
  description         String?
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  reorderLevel        Int             @default(5) @map("reorder_level")
  stockOnHand         Int             @default(0) @map("stock_on_hand")
  totalReceived       Int             @default(0) @map("total_received")
  totalSold           Int             @default(0) @map("total_sold")
  totalAdjusted       Int             @default(0) @map("total_adjusted")
  alertedBelowReorder Boolean         @default(false) @map("alerted_below_reorder")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  saleItems SaleItem[]
  movements StockMovement[]

  @@index([name])
  @@index([category])
  @@map("products")
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String       @map("product_id")
  type      MovementType
  quantity  Int
  note      String?
  userId    String?      @map("user_id")
  saleId    String?      @map("sale_id")
  createdAt DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id         String   @id @default(cuid())
  saleNumber String   @unique @map("sale_number")
  employeeId String   @map("employee_id")
  total      Decimal  @db.Decimal(12, 2)
  itemCount  Int      @map("item_count")
  createdAt  DateTime @default(now()) @map("created_at")

  employee  User             @relation(fields: [employeeId], references: [id])
  items     SaleItem[]
  movements StockMovement[]

  @@index([createdAt])
  @@index([employeeId])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String  @map("sale_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  sku         String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model SaleSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("sale_sequences")
}
